      "author": "杜甫",
      "dynasty": "唐",
      "kind": "poem",
      "paragraphs": [
        "锦城丝管日纷纷，半入江风半入云。",
        "此曲只应天上有，人间能得几回闻？。"
      ],
      "sourceUrl": "https://github.com/chinese-poetry/chinese-poetry",
